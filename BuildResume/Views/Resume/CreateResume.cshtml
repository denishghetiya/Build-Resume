@model BuildResume.ViewModels.ResumeDataViewModel
<div id="errors" style="color:red"></div>
<div class="row">
    <div class="col">
        
        <form id="createResumeForm" class="p-3">

            <input type="hidden" asp-for="UserId" />

            <div class="col">
                <label class="form-label fw-bold">Templates :</label>
                <select asp-for="searchTemplate" class="form-control">
                    <option value="">--Select Template--</option>
                    <option value="_Template1">Template 1</option>
                    <option value="_Template2">Template 2</option>
                </select>
            </div>
            <br/>
            <div class="row mb-3">
                <div class="col-md-3">
                    <label asp-for="FirstName" class="form-label">FirstName</label>
                    <input asp-for="FirstName" type="text" value="@Model.FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="LastName" class="form-label">LastName</label>
                    <input asp-for="LastName" type="text" value="@Model.LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="PhoneNumber" class="form-label">PhoneNumber</label>
                    <input asp-for="PhoneNumber" type="number" value="@Model.PhoneNumber" class="form-control" minlength="10" maxlength="15"/>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" value="@Model.Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group exp">

                <button type="button" class="btn btn-sm btn-info add-partialbutton" id="addPartialButton">Add New Experience</button>
                <br /><br />
                <div class="row" id="partialViewContainer">

                    @foreach (var experince in Model.Experience)
                    {
                        <div class="col-md-10">
                            @await Html.PartialAsync("_Experience", experince)
                        </div>

                        <hr />
                    }
                </div>
            </div>
            <br />
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="ResumeList" class="btn btn-secondary">Cancel</a>

        </form>
    </div>
    <br />
    <div class="col">
        <div id="template"></div>
        <br/>
        <div class="summaryContainer" id="summaryContainer"></div>
        <br/>
        <button class="btn btn-secondary" id="convertingtopdf">Generate PDF</button>
    </div>
</div>

<script src="~/js/site.js" asp-append-version="true"></script>